# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# blog migration raw cache (regenerable from the WP API; not committed)
/scripts/blog-migration/.cache/

# local estimate of Fal.AI spend (not real billing -- see fal.ai/dashboard/billing)
/scripts/.fal_spend.json

# .fal_bar_color_history.json NAO entra aqui de proposito: e o estado do
# anti-repeticao de cor da tarja das capas. Ja foi ignorado uma vez, o
# arquivo sumiu e as ultimas 6 capas sairam todas em teal -- ele precisa
# viajar junto com o repo.
__pycache__/

# scratch previews (skill /violao), never meant to be committed
/.previews/

# generated docs (regenerable from the .md source)
/docs/*.pdf

.vercel

# exportacoes de dados de alunos (migracao Hotmart) -- dados pessoais, nunca commitar
/nave_*

# backups de DNS gerados por scripts/cloudflare_dns.py
backups/
